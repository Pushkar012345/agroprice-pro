datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

model MarketPrice {
  id           Int            @id @default(autoincrement())
  commodity    String
  market       String
  district     String
  modalPrice   Float
  minPrice     Float
  maxPrice     Float
  timestamp    DateTime       @default(now())
  priceHistory PriceHistory[]

  @@index([commodity])
  @@index([district])
}

model PriceHistory {
  id            Int          @id @default(autoincrement())
  marketPriceId Int
  modalPrice    Float
  minPrice      Float
  maxPrice      Float
  recordedAt    DateTime
  marketPrice   MarketPrice  @relation(fields: [marketPriceId], references: [id])

  @@index([marketPriceId])
}

// RAG knowledge base. Read/written with raw SQL (see rag/store.js) because Prisma
// has no native pgvector type. The dimension (768) must match EMBED_DIMS.
model KnowledgeChunk {
  id          Int                          @id @default(autoincrement())
  source      String
  title       String
  url         String?
  chunkIndex  Int
  content     String
  embedding   Unsupported("vector(768)")
  // Generated by Postgres from title + content (see add_knowledge_fts migration). Never written by Prisma.
  searchTsv   Unsupported("tsvector")?     @map("search_tsv")
  createdAt   DateTime                     @default(now())

  @@unique([source, chunkIndex])
  @@index([source])
  @@index([searchTsv], type: Gin)
}
