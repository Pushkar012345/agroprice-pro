DATABASE_URL=postgresql://user:password@host:5432/postgres
# DATABASE_SSL=false   # only for the MCP server against a local Postgres without SSL
GROQ_API_KEY=
DATA_GOV_API_KEY=
FRONTEND_URL=http://localhost:5173

# RAG (optional; without GEMINI_API_KEY the agent runs without search_knowledge)
GEMINI_API_KEY=
# EMBED_MODEL=gemini-embedding-001
# EMBED_DIMS=768        # must match vector(768) in the migration
# RAG_MIN_SCORE=0.55    # similarity cutoff; tune with: npm run ingest -- --query "..."
# RAG_MODE=hybrid       # hybrid (default) | vector | keyword. Hybrid needs the add_knowledge_fts migration.
# RAG_CANDIDATES=15     # chunks taken from each ranker before fusion / reranking

# Reranker (optional; without RERANK_API_KEY retrieval is hybrid search only)
# Jina:   https://jina.ai/reranker   (free tier)     Cohere: https://dashboard.cohere.com (trial key)
RERANK_API_KEY=
# RERANK_PROVIDER=jina              # jina (default) | cohere
# RERANK_MODEL=                     # default: jina-reranker-v2-base-multilingual / rerank-v3.5

# Observability (optional; without both keys tracing is off). https://cloud.langfuse.com (free tier)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # use https://us.cloud.langfuse.com for the US region
# Optional pricing (USD per 1M tokens) so Langfuse shows cost for models it has no price list for:
# AGENT_COST_IN_PER_M=0.15
# AGENT_COST_OUT_PER_M=0.60
